EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Your computer's LAN IP, where 'npm run dev:lan' runs the API (phone and PC on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# Optional: the web app's address, so the password-reset email lands on its set-new-password page (also add it as an allowed redirect URL in Supabase)
EXPO_PUBLIC_WEB_URL=
